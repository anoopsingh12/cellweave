{
  "name": "cellweave",
  "version": "1.0.0",
  "description": "A powerful JavaScript library for creating feature-rich Excel (.xlsx) spreadsheets. Supports all Excel features: styling, formulas, charts, pivot tables, data validation, conditional formatting, tables, images, and more.",
  "main": "index.js",
  "files": [
    "index.js",
    "src/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "example": "node examples/comprehensive.js",
    "lint": "node --check src/**/*.js index.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "excel",
    "xlsx",
    "spreadsheet",
    "workbook",
    "worksheet",
    "openxml",
    "ooxml",
    "office",
    "cellweave",
    "xls",
    "charts",
    "pivot",
    "formula",
    "conditional-formatting",
    "data-validation",
    "nodejs",
    "browser"
  ],
  "author": "Anoop Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anoopsingh12/cellweave.git"
  },
  "bugs": {
    "url": "https://github.com/anoopsingh12/cellweave/issues"
  },
  "homepage": "https://github.com/anoopsingh12/cellweave#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "jest": "^29.7.0",
    "rollup": "^4.21.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "src/**/*.js",
      "index.js",
      "!src/interfaces/**"
    ],
    "coverageReporters": ["text", "lcov"],
    "coverageDirectory": "coverage"
  }
}
